    function runSimulation(recordHistory = true) {
      const { income, expense, installment, savings } = appState.finance;
      const beforeOut = expense + installment;
      const beforeNet = income - beforeOut;

      const sevFactor = appState.simulation.severity === 'dasar' ? 1 : (appState.simulation.severity === 'moderat' ? 2 : 3);
      let afterIncome = income;
      let afterOut = beforeOut;
      let explanation = '';
      let scenarioLabel = '';

      if (appState.simulation.type === 'income_drop') {
        const dropPct = sevFactor === 1 ? 0.20 : (sevFactor === 2 ? 0.35 : 0.50);
        afterIncome = income * (1 - dropPct);
        scenarioLabel = `Pendapatan Turun (-${Math.round(dropPct * 100)}%)`;
        explanation = `Jika pendapatan turun ${Math.round(dropPct * 100)}% menjadi ${formatRp(afterIncome)}, `;
      } else if (appState.simulation.type === 'expense_up') {
        const upPct = sevFactor === 1 ? 0.15 : (sevFactor === 2 ? 0.30 : 0.45);
        afterOut = (expense * (1 + upPct)) + installment;
        scenarioLabel = `Pengeluaran Naik (+${Math.round(upPct * 100)}%)`;
        explanation = `Kenaikan biaya rutin sebesar ${Math.round(upPct * 100)}% menaikkan total pengeluaran menjadi ${formatRp(afterOut)}. `;
      } else if (appState.simulation.type === 'emergency') {
        const shock = sevFactor === 1 ? 1000000 : (sevFactor === 2 ? 2500000 : 4500000);
        afterOut = beforeOut + shock;
        scenarioLabel = `Pengeluaran Mendadak (${formatRp(shock)})`;
        explanation = `Kebutuhan darurat sebesar ${formatRp(shock)} bulan ini menekan arus kas secara langsung. `;
      } else {
        const penalty = sevFactor === 1 ? 150000 : (sevFactor === 2 ? 350000 : 750000);
        afterOut = beforeOut + penalty + (sevFactor > 1 ? installment * 0.5 : 0);
        scenarioLabel = `Keterlambatan Bayar`;
        explanation = `Denda keterlambatan dan akumulasi tagihan menambah beban bulan berikutnya sebesar ${formatRp(afterOut - beforeOut)}. `;
      }

      const afterNet = afterIncome - afterOut;
      const badge = document.getElementById('sim-result-badge');

      if (afterNet >= 300000) {
        badge.textContent = 'Tetap Aman';
        badge.className = 'px-2.5 py-1 rounded-full bg-softMint text-emeraldPrimary text-[11px] font-bold';
        explanation += `Sisa kas masih positif (${formatRp(afterNet)}), sehingga cicilan tetap terbayar lancar.`;
      } else if (afterNet >= 0) {
        badge.textContent = 'Waspada';
        badge.className = 'px-2.5 py-1 rounded-full bg-amber-100 text-amber-800 text-[11px] font-bold';
        explanation += `Sisa kas sangat tipis (${formatRp(afterNet)}). Ruang menabung hilang dan rawan terlambat bayar jika ada biaya tambahan.`;
      } else {
        badge.textContent = 'Defisit Kas';
        badge.className = 'px-2.5 py-1 rounded-full bg-red-100 text-riskRed text-[11px] font-bold';
        explanation += `Terjadi kekurangan kas ${formatRp(afterNet)}. Kamu harus mengambil dari simpanan (${formatRp(savings)}) untuk menutup kewajiban.`;
      }

      document.getElementById('sim-before-cash').textContent = (beforeNet >= 0 ? '+' : '') + formatRp(beforeNet);
      document.getElementById('sim-after-cash').textContent = (afterNet >= 0 ? '+' : '') + formatRp(afterNet);
      document.getElementById('sim-after-cash').className = `font-heading font-bold text-sm ${afterNet >= 0 ? 'text-emeraldPrimary' : 'text-riskRed'}`;
      document.getElementById('sim-impact-text').textContent = explanation;

      // Update Grafik Perbandingan Simulasi
      if (simChart) {
        simChart.data.datasets[0].data = [income, beforeOut, Math.max(0, beforeNet)];
        simChart.data.datasets[1].data = [afterIncome, afterOut, Math.max(0, afterNet)];
        simChart.update();
      }

      if (recordHistory) {
        appState.simulation.history.unshift({
          title: `${scenarioLabel} (${appState.simulation.severity.toUpperCase()})`,
          date: 'Baru saja',
          status: afterNet >= 0 ? 'Terkendali' : 'Defisit Kas',
          delta: (afterNet >= 0 ? '+' : '') + formatRp(afterNet)
        });
        renderSimulationHistory();
        showToast('Simulasi selesai! Cek grafik & dampak di bawah.');
      }
    }

    // ------------------------------------------
    // 6. RISIKO PEMBIAYAAN (FITUR 3)
    // ------------------------------------------
    function calculateRisk() {
      const loan = Number(document.getElementById('risk-loan').value) || 0;
      const rate = Number(document.getElementById('risk-rate').value) || 0;
      const tenor = Math.max(1, Number(document.getElementById('risk-tenor').value) || 1);
      const income = Math.max(1, Number(document.getElementById('risk-income').value) || 1);

      const totalInterest = loan * (rate / 100) * (tenor / 12);
      const totalPayment = loan + totalInterest;
      const monthlyInstallment = totalPayment / tenor;
      const dsr = (monthlyInstallment / income) * 100;

      document.getElementById('risk-monthly-installment').textContent = formatRp(monthlyInstallment);
      document.getElementById('risk-total-payment').textContent = formatRp(totalPayment);
      document.getElementById('risk-dsr-val').textContent = `${dsr.toFixed(1)}%`;

      const card = document.getElementById('risk-indicator-card');
      const pill = document.getElementById('risk-level-pill');
      const dsrEl = document.getElementById('risk-dsr-val');
      const expEl = document.getElementById('risk-explanation');

      if (dsr <= 30) {
        card.className = 'rounded-3xl p-5 border-2 transition-all bg-softMint border-emeraldPrimary';
        pill.className = 'px-3 py-1 rounded-full bg-emeraldPrimary text-white text-xs font-bold';
        pill.textContent = 'HIJAU • RELATIF AMAN';
        dsrEl.className = 'font-heading font-extrabold text-base text-emeraldPrimary';
        expEl.textContent = `Rasio cicilan ${dsr.toFixed(1)}% berada di batas sehat (≤30% pendapatan). Sisa pendapatan masih cukup untuk kebutuhan pokok dan simpanan.`;
      } else if (dsr <= 40) {
        card.className = 'rounded-3xl p-5 border-2 transition-all bg-amber-50 border-goldAccent';
        pill.className = 'px-3 py-1 rounded-full bg-goldAccent text-darkNavy text-xs font-bold';
        pill.textContent = 'KUNING • PERLU DIPERHATIKAN';
        dsrEl.className = 'font-heading font-extrabold text-base text-amber-700';
        expEl.textContent = `Rasio cicilan ${dsr.toFixed(1)}% mulai membebani arus kas (30%–40%). Pertimbangkan memperpanjang tenor atau memperkecil nominal pinjaman agar tidak terjadi kekurangan kas.`;
      } else {
        card.className = 'rounded-3xl p-5 border-2 transition-all bg-red-50 border-riskRed';
        pill.className = 'px-3 py-1 rounded-full bg-riskRed text-white text-xs font-bold';
        pill.textContent = 'MERAH • RISIKO TINGGI';
        dsrEl.className = 'font-heading font-extrabold text-base text-riskRed';
        expEl.textContent = `Peringatan! Rasio cicilan ${dsr.toFixed(1)}% melebihi 40% pendapatan. Risiko gagal bayar dan kekurangan kas bulanan sangat tinggi.`;
      }
    }

    // ------------------------------------------
    // 7. KELAYAKAN USAHA & BEP (FITUR 4)
    // ------------------------------------------
    function calculateBusiness() {
      const name = document.getElementById('biz-name').value || 'Usaha Baru';
      const capital = Number(document.getElementById('biz-capital').value) || 0;
      const fixed = Number(document.getElementById('biz-fixed').value) || 0;
      const varCost = Number(document.getElementById('biz-var').value) || 0;
      const price = Number(document.getElementById('biz-price').value) || 0;
      const target = Number(document.getElementById('biz-target').value) || 0;

      const revenue = price * target;
      const totalVar = varCost * target;
      const totalCost = fixed + totalVar;
      const profit = revenue - totalCost;
      const marginPerUnit = price - varCost;
      const bepUnits = marginPerUnit > 0 ? Math.ceil(fixed / marginPerUnit) : 0;
      const paybackMonths = profit > 0 ? (capital / profit).toFixed(1) : 'Belum Balik Modal';

      document.getElementById('biz-display-name').textContent = name;
      document.getElementById('biz-revenue').textContent = formatRp(revenue);
      document.getElementById('biz-profit').textContent = (profit >= 0 ? '+' : '') + formatRp(profit);
      document.getElementById('biz-profit').className = `font-heading font-bold text-sm ${profit >= 0 ? 'text-emerald-300' : 'text-red-300'}`;
      document.getElementById('biz-bep-unit').textContent = marginPerUnit > 0 ? `${bepUnits} Unit / Bln` : 'Margin Negatif';
      document.getElementById('biz-payback').textContent = profit > 0 ? `± ${paybackMonths} Bulan` : 'Rugi Operasional';

      const badge = document.getElementById('biz-feasible-badge');
      if (profit > 0 && target > bepUnits) {
        badge.textContent = 'Layak Dijalankan';
        badge.className = 'px-3 py-1 rounded-full bg-emeraldPrimary text-xs font-bold';
      } else {
        badge.textContent = 'Perlu Evaluasi Harga/Biaya';
        badge.className = 'px-3 py-1 rounded-full bg-riskRed text-xs font-bold';
      }

      // Uji sensitivitas turun 20%
      const dropUnits = Math.floor(target * 0.8);
      const dropProfit = (price - varCost) * dropUnits - fixed;
      document.getElementById('biz-stress-note').textContent =
        `Ketahanan Usaha: Jika penjualan turun 20% (${dropUnits} unit/bln), proyeksi laba menjadi ${formatRp(dropProfit)}/bln (${dropProfit >= 0 ? 'masih di atas titik impas' : 'di bawah BEP, perlu dana cadangan'}).`;

      if (bizChart) {
        bizChart.data.datasets[0].data = [revenue * 0.6, revenue * 0.8, revenue, revenue * 1.15];
        bizChart.data.datasets[1].data = [
          fixed + varCost * (target * 0.6),
          fixed + varCost * (target * 0.8),
          totalCost,
          fixed + varCost * (target * 1.15)
        ];
        bizChart.update();
      }
      updateCoopSharePreview();
    }

    // ------------------------------------------
    // 8. PEMBELAJARAN ADAPTIF & KUIS (FITUR 5)
    // ------------------------------------------
    function renderEduModules(filter = 'all') {
      const container = document.getElementById('edu-modules-list');
      const filtered = eduModules.filter(m => {
        if (filter === 'rekomendasi') return m.recommended;
        if (filter === 'usaha') return m.category === 'usaha';
        return true;
      });

      container.innerHTML = filtered.map(m => {
        const isDone = appState.completedModules.includes(m.id);
        return `
          <div onclick="openModuleReader(${m.id})" class="p-4 rounded-2xl bg-white border ${m.recommended ? 'border-emeraldPrimary/35' : 'border-slate-100'} shadow-card cursor-pointer hover:border-emeraldPrimary transition">
            <div class="flex items-center justify-between mb-1.5">
              <div class="flex items-center gap-1.5">
                ${m.recommended ? '<span class="px-2 py-0.5 rounded-md bg-softMint text-emeraldPrimary text-[10px] font-bold">Rekomendasi</span>' : ''}
                <span class="text-[10px] text-slate-400 font-medium">${m.duration}</span>
              </div>
              <span class="text-[11px] font-semibold ${isDone ? 'text-emeraldPrimary' : 'text-slate-400'}">
                ${isDone ? '✓ Selesai' : 'Mulai →'}
              </span>
            </div>
            <h4 class="font-heading font-bold text-xs text-darkNavy">${m.title}</h4>
            <p class="text-[11px] text-slate-500 mt-1 line-clamp-2">${m.summary}</p>
          </div>
        `;
      }).join('');

      const pct = Math.round((appState.completedModules.length / eduModules.length) * 100);
      document.getElementById('edu-progress-text').textContent = `${appState.completedModules.length} / ${eduModules.length} Modul Selesai`;
      document.getElementById('edu-progress-bar').style.width = `${pct}%`;
    }

    function filterEduModules(cat) {
      document.querySelectorAll('.edu-cat-btn').forEach(btn => {
        btn.className = 'edu-cat-btn px-3.5 py-1.5 rounded-full bg-lightGray text-darkNavy text-xs font-semibold shrink-0';
      });
      event.target.className = 'edu-cat-btn px-3.5 py-1.5 rounded-full bg-emeraldPrimary text-white text-xs font-semibold shrink-0';
      renderEduModules(cat);
    }

    function openModuleReader(id) {
      const mod = eduModules.find(m => m.id === id);
      if (!mod) return;
      appState.activeModuleIndex = id;
      document.getElementById('reader-tag').textContent = mod.recommended ? 'Rekomendasi Adaptif' : 'Materi Literasi';
      document.getElementById('reader-title').textContent = mod.title;
      document.getElementById('reader-body').innerHTML = `
        <p>${mod.summary}</p>
        <div class="p-3.5 rounded-2xl bg-softMint border border-emeraldPrimary/20 text-darkNavy">
          <strong class="block text-emeraldPrimary mb-1">Infografik Ringkas:</strong>
          <span>${mod.infographic}</span>
        </div>
        <div class="p-3.5 rounded-2xl bg-amber-50 border border-amber-200 text-amber-950">
          <strong class="block text-amber-700 mb-1">Tips Praktis:</strong>
          <span>${mod.tip}</span>
        </div>
      `;
      document.getElementById('reader-complete-btn').classList.remove('hidden');
      openModal('modal-reader');
    }

    function openArticleModal(idx) {
      openModuleReader(idx === 0 ? 2 : 3);
    }

    function completeCurrentModule() {
      if (appState.activeModuleIndex !== null && !appState.completedModules.includes(appState.activeModuleIndex)) {
        appState.completedModules.push(appState.activeModuleIndex);
        renderEduModules('all');
        showToast('Modul selesai! Progress literasi meningkat.');
      }
      closeModal('modal-reader');
    }

    function answerQuiz(btn, isCorrect) {
      const fb = document.getElementById('quiz-feedback');
      fb.classList.remove('hidden');
      if (isCorrect) {
        fb.className = 'text-xs font-medium p-3 rounded-xl bg-emeraldPrimary text-white';
        fb.textContent = 'Tepat sekali! Total cicilan maksimal 30% menjaga arus kasmu tetap aman untuk kebutuhan pokok dan tabungan.';
      } else {
        fb.className = 'text-xs font-medium p-3 rounded-xl bg-red-100 text-riskRed';
        fb.textContent = 'Belum tepat. Batas sehat total cicilan adalah maksimal 30% dari pendapatan bulanan (Rp 1.050.000).';
      }
    }

    // ------------------------------------------
    // 9. KOPERASI MITRA & PERSETUJUAN (FITUR 6)
    // ------------------------------------------
    function renderPartnerCoops() {
      const container = document.getElementById('coop-list');
      container.innerHTML = partnerCoops.map(c => `
        <div class="bg-white border border-slate-100 rounded-3xl p-4 shadow-card space-y-2.5">
          <div class="flex items-start justify-between gap-2">
            <div>
              <h3 class="font-heading font-bold text-sm text-darkNavy">${c.name}</h3>
              <span class="text-[11px] text-emeraldPrimary font-medium">${c.location}</span>
            </div>
            <button onclick="selectCoopForConsult('${c.name}')" class="px-3 py-1.5 rounded-xl bg-softMint hover:bg-emeraldPrimary hover:text-white text-emeraldPrimary text-xs font-semibold transition shrink-0">
              Pilih
            </button>
          </div>
          <p class="text-xs text-slate-600">${c.focus}</p>
          <div class="flex flex-wrap gap-1.5 pt-1">
            ${c.services.map(s => `<span class="px-2.5 py-1 rounded-lg bg-lightGray text-[10px] font-medium text-darkNavy">${s}</span>`).join('')}
          </div>
        </div>
      `).join('');
    }

    function selectCoopForConsult(name) {
      appState.selectedCoop = name;
      document.getElementById('selected-coop-tag').textContent = name;
      document.getElementById('coop-consult-box').scrollIntoView({ behavior: 'smooth' });
      showToast(`Dipilih: ${name}`);
    }

    function updateCoopSharePreview() {
      const { income, expense, installment } = appState.finance;
      const net = income - (expense + installment);
      const ratio = income > 0 ? (((expense + installment) / income) * 100).toFixed(1) : 0;
      const bep = document.getElementById('biz-bep-unit')?.textContent || '215 Unit / Bln';
      const el = document.getElementById('coop-share-preview');
      if (el) {
        el.textContent = `Sisa Kas: ${formatRp(net)}/bln • Rasio Pengeluaran: ${ratio}% • Target BEP Usaha: ${bep}.`;
      }
    }

    function submitCoopConsultation() {
      const consent = document.getElementById('coop-consent-checkbox').checked;
      if (!consent) {
        showToast('Harap centang persetujuan berbagi data terlebih dahulu.');
        return;
      }
      showToast(`Permintaan pendampingan terkirim ke ${appState.selectedCoop}!`);
      document.getElementById('coop-consent-checkbox').checked = false;
    }

    // ------------------------------------------
    // 10. CHARTS & RIWAYAT
    // ------------------------------------------
    function initAllDataAndCharts() {
      renderEduModules('all');
      renderPartnerCoops();
      renderSimulationHistory();

      // 1. Home Cashflow Chart
      const ctxHome = document.getElementById('homeCashflowChart').getContext('2d');
      if (homeChart) homeChart.destroy();
      homeChart = new Chart(ctxHome, {
        type: 'bar',
        data: {
          labels: ['Pendapatan', 'Pengeluaran', 'Cicilan', 'Sisa Kas'],
          datasets: [{
            data: [3500000, 1900000, 450000, 1150000],
            backgroundColor: ['#087F5B', '#142D4E', '#DC5555', '#E5B454'],
            borderRadius: 10
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, ticks: { font: { size: 10 } }, grid: { color: '#F1F5F9' } },
            x: { ticks: { font: { size: 10, weight: '600' } }, grid: { display: false } }
          }
        }
      });

      // 2. Finance Detail Doughnut
      const ctxFin = document.getElementById('financeDetailChart').getContext('2d');
      if (finDetailChart) finDetailChart.destroy();
      finDetailChart = new Chart(ctxFin, {
        type: 'doughnut',
        data: {
          labels: ['Pengeluaran Rutin', 'Cicilan', 'Sisa Kas / Tabungan'],
          datasets: [{
            data: [1900000, 450000, 1150000],
            backgroundColor: ['#142D4E', '#DC5555', '#087F5B'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '65%',
          plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } }
        }
      });

      // 3. Simulation Compare Chart
      const ctxSim = document.getElementById('simulationCompareChart').getContext('2d');
      if (simChart) simChart.destroy();
      simChart = new Chart(ctxSim, {
        type: 'bar',
        data: {
          labels: ['Pendapatan', 'Total Keluar', 'Sisa Kas'],
          datasets: [
            { label: 'Sebelum', data: [3500000, 2350000, 1150000], backgroundColor: '#142D4E', borderRadius: 8 },
            { label: 'Sesudah', data: [2800000, 2350000, 450000], backgroundColor: '#087F5B', borderRadius: 8 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } },
          scales: {
            y: { beginAtZero: true, ticks: { font: { size: 10 } } },
            x: { ticks: { font: { size: 10 } }, grid: { display: false } }
          }
        }
      });

      // 4. Business Projection Chart
      const ctxBiz = document.getElementById('businessChart').getContext('2d');
      if (bizChart) bizChart.destroy();
      bizChart = new Chart(ctxBiz, {
        type: 'line',
        data: {
          labels: ['60% Target', '80% Target', '100% Target', '115% Target'],
          datasets: [
            { label: 'Pendapatan', data: [3150000, 4200000, 5250000, 6037500], borderColor: '#087F5B', backgroundColor: 'rgba(8,127,91,0.1)', fill: true, tension: 0.35 },
            { label: 'Total Biaya', data: [3180000, 3740000, 4300000, 4720000], borderColor: '#DC5555', borderDash: [5, 5], tension: 0.35 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } },
          scales: {
            y: { beginAtZero: true, ticks: { font: { size: 10 } } },
            x: { ticks: { font: { size: 10 } }, grid: { display: false } }
          }
        }
      });

      recalculateFinance();
      calculateBusiness();
    }

    function updateCharts() {
      const { income, expense, installment } = appState.finance;
      const net = Math.max(0, income - (expense + installment));
      if (homeChart) {
        homeChart.data.datasets[0].data = [income, expense, installment, net];
        homeChart.update();
      }
      if (finDetailChart) {
        finDetailChart.data.datasets[0].data = [expense, installment, net];
        finDetailChart.update();
      }
    }

    function renderSimulationHistory() {
      const container = document.getElementById('simulation-history-list');
      document.getElementById('history-count').textContent = `${appState.simulation.history.length} Simulasi`;
      container.innerHTML = appState.simulation.history.slice(0, 4).map(item => `
        <div class="p-3 rounded-2xl bg-lightGray flex items-center justify-between">
          <div>
            <span class="font-heading font-semibold text-xs text-darkNavy block">${item.title}</span>
            <span class="text-[10px] text-slate-400">${item.date} • ${item.status}</span>
          </div>
          <span class="font-heading font-bold text-xs ${item.delta.startsWith('-') ? 'text-riskRed' : 'text-emeraldPrimary'}">${item.delta}</span>
        </div>
      `).join('');
    }

    // ------------------------------------------
    // 11. MODAL & TOAST HELPERS
    // ------------------------------------------
    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
      lucide.createIcons();
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    let toastTimer = null;
    function showToast(msg) {
      const toast = document.getElementById('toast-box');
      document.getElementById('toast-message').textContent = msg;
      toast.classList.remove('hidden');
      lucide.createIcons();
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.add('hidden'), 3000);
    }

    // Initialize on Window Load
    window.onload = function () {
      renderOnboarding();
      lucide.createIcons();
    };
  </script>
</body>
</html>
