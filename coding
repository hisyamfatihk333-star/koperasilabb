<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>KoperasiLab — Simulasikan Keuanganmu, Siapkan Masa Depanmu</title>

  <!-- Google Fonts: Poppins & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Chart.js untuk Visualisasi Data Interaktif -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            emeraldPrimary: '#087F5B',
            emeraldDark: '#066045',
            darkNavy: '#142D4E',
            softMint: '#E6F4EF',
            goldAccent: '#E5B454',
            lightGray: '#F3F5F7',
            riskRed: '#DC5555',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            display: ['Poppins', 'sans-serif'],
          },
          boxShadow: {
            'soft': '0 4px 20px -2px rgba(20, 45, 78, 0.06)',
            'card': '0 2px 12px rgba(20, 45, 78, 0.05)',
            'float': '0 10px 25px -5px rgba(8, 127, 91, 0.25)',
          }
        }
      }
    }
  </script>

  <style>
    body {
      background-color: #E2E8F0;
      font-family: 'Inter', sans-serif;
      color: #142D4E;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    h1, h2, h3, h4, .font-heading {
      font-family: 'Poppins', sans-serif;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .page-section {
      animation: fadeIn 0.22s ease-out;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: transparent;
      cursor: pointer;
    }
    input[type="range"]::-webkit-slider-runnable-track {
      background: #E6F4EF;
      height: 8px;
      border-radius: 999px;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      margin-top: -5px;
      background-color: #087F5B;
      height: 18px;
      width: 18px;
      border-radius: 50%;
      border: 2px solid #FFFFFF;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body class="flex justify-center min-h-screen bg-slate-200">

  <!-- Mobile App Viewport Frame (Android Smartphone Aspect Ratio) -->
  <div id="app-frame" class="relative w-full max-w-[430px] bg-white min-h-screen shadow-2xl flex flex-col overflow-x-hidden">

    <!-- ========================================== -->
    <!-- 1. ONBOARDING SCREEN                       -->
    <!-- ========================================== -->
    <div id="screen-onboarding" class="fixed inset-0 z-50 max-w-[430px] mx-auto bg-white flex flex-col justify-between p-6">
      <div class="flex justify-between items-center pt-2">
        <div class="flex items-center gap-2">
          <div class="w-9 h-9 rounded-xl bg-emeraldPrimary flex items-center justify-center text-white font-bold shadow-sm">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <span class="font-heading font-bold text-lg text-darkNavy tracking-tight">KoperasiLab</span>
        </div>
        <button onclick="finishOnboarding()" class="text-sm font-medium text-slate-500 hover:text-emeraldPrimary px-3 py-1.5 rounded-lg">
          Lewati
        </button>
      </div>

      <!-- Slide Content -->
      <div id="onboarding-content" class="my-auto text-center px-2"></div>

      <!-- Bottom Controls -->
      <div class="pb-4 space-y-5">
        <div id="onboarding-dots" class="flex justify-center gap-2"></div>
        <div class="flex gap-3">
          <button id="onboarding-prev-btn" onclick="prevOnboardingSlide()" class="hidden py-3.5 px-4 bg-lightGray hover:bg-slate-200 text-darkNavy font-heading font-semibold rounded-2xl transition active:scale-[0.98] items-center justify-center">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
          </button>
          <button id="onboarding-next-btn" onclick="nextOnboardingSlide()" class="flex-1 py-3.5 px-6 bg-emeraldPrimary hover:bg-emeraldDark text-white font-heading font-semibold rounded-2xl shadow-float transition active:scale-[0.98] flex items-center justify-center gap-2">
            <span>Lanjutkan</span>
            <i data-lucide="arrow-right" class="w-5 h-5"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 2. AUTH SCREEN (LOGIN / REGISTER)          -->
    <!-- ========================================== -->
    <div id="screen-auth" class="hidden fixed inset-0 z-40 max-w-[430px] mx-auto bg-white flex flex-col justify-between p-6 overflow-y-auto">
      <div class="pt-2">
        <!-- Back to Onboarding -->
        <button onclick="backToOnboarding()" class="mb-4 inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-darkNavy py-1.5 px-2.5 rounded-lg bg-lightGray transition">
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
          <span>Kembali ke Pengenalan</span>
        </button>

        <div class="flex items-center gap-2.5 mb-6">
          <div class="w-11 h-11 rounded-2xl bg-emeraldPrimary flex items-center justify-center text-white shadow-soft">
            <i data-lucide="shield-check" class="w-6 h-6"></i>
          </div>
          <div>
            <h1 class="font-heading font-bold text-xl text-darkNavy">KoperasiLab</h1>
            <p class="text-xs text-slate-500">Simulasikan Keuanganmu, Siapkan Masa Depanmu.</p>
          </div>
        </div>

        <!-- Tabs Login / Daftar -->
        <div class="grid grid-cols-2 bg-lightGray p-1 rounded-xl mb-6">
          <button id="tab-login" onclick="switchAuthMode('login')" class="py-2.5 text-sm font-semibold rounded-lg bg-white text-darkNavy shadow-xs transition">Masuk</button>
          <button id="tab-register" onclick="switchAuthMode('register')" class="py-2.5 text-sm font-medium rounded-lg text-slate-500 transition">Daftar Baru</button>
        </div>

        <form id="auth-form" onsubmit="handleAuthSubmit(event)" class="space-y-4">
          <div id="auth-name-field" class="hidden">
            <label class="block text-xs font-semibold text-darkNavy mb-1.5">Nama Lengkap</label>
            <input type="text" id="auth-name" placeholder="Contoh: Nadia Putri" class="w-full px-4 py-3 rounded-xl bg-lightGray border border-transparent focus:border-emeraldPrimary focus:bg-white text-sm outline-none transition" />
          </div>

          <div id="auth-role-field" class="hidden">
            <label class="block text-xs font-semibold text-darkNavy mb-1.5">Profil Kamu</label>
            <select id="auth-role" class="w-full px-4 py-3 rounded-xl bg-lightGray border border-transparent focus:border-emeraldPrimary focus:bg-white text-sm outline-none transition">
              <option value="Mahasiswa">Mahasiswa</option>
              <option value="Wirausaha Pemula">Wirausaha Pemula</option>
              <option value="Generasi Muda / Pekerja">Generasi Muda / Pekerja</option>
              <option value="Calon Anggota Koperasi">Calon Anggota Koperasi</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-semibold text-darkNavy mb-1.5">Email</label>
            <input type="email" id="auth-email" value="nadia.mahasiswa@kampus.ac.id" required class="w-full px-4 py-3 rounded-xl bg-lightGray border border-transparent focus:border-emeraldPrimary focus:bg-white text-sm outline-none transition" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-darkNavy mb-1.5">Kata Sandi</label>
            <input type="password" id="auth-password" value="••••••••" required class="w-full px-4 py-3 rounded-xl bg-lightGray border border-transparent focus:border-emeraldPrimary focus:bg-white text-sm outline-none transition" />
          </div>

          <div class="bg-softMint/70 border border-emeraldPrimary/20 rounded-xl p-3 flex items-start gap-2.5">
            <i data-lucide="lock" class="w-4 h-4 text-emeraldPrimary shrink-0 mt-0.5"></i>
            <p class="text-[11px] text-darkNavy/80 leading-relaxed">
              <strong>Privasi Terjamin:</strong> KoperasiLab tidak pernah meminta akses rekening bank. Semua simulasi menggunakan input mandiri untuk tujuan edukasi.
            </p>
          </div>

          <button type="submit" id="auth-submit-btn" class="w-full py-3.5 bg-emeraldPrimary hover:bg-emeraldDark text-white font-heading font-semibold rounded-2xl shadow-float transition active:scale-[0.98]">
            Masuk ke KoperasiLab
          </button>
        </form>
      </div>

      <div class="pt-6 pb-2 text-center">
        <button onclick="demoQuickLogin()" class="text-xs font-semibold text-emeraldPrimary hover:underline">
          Atau masuk langsung dengan Akun Demo Mahasiswa →
        </button>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- 3. MAIN APP SHELL (HEADER + CONTENT + NAV) -->
    <!-- ========================================== -->
    <div id="main-app-shell" class="hidden flex-1 flex flex-col pb-24">

      <!-- TOP BAR DENGAN TOMBOL BACK DINAMIS -->
      <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-100 px-5 py-3.5 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <!-- Tombol Back muncul otomatis saat tidak berada di halaman Home -->
          <button id="header-back-btn" onclick="goBack()" class="hidden p-2 rounded-xl bg-lightGray hover:bg-softMint text-darkNavy transition active:scale-95" title="Kembali">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
          </button>

          <div id="header-brand-logo" class="w-9 h-9 rounded-xl bg-emeraldPrimary flex items-center justify-center text-white shadow-xs">
            <i data-lucide="shield-check" class="w-5 h-5"></i>
          </div>
          <div>
            <span id="header-title" class="font-heading font-bold text-base text-darkNavy block leading-none">KoperasiLab</span>
            <span id="header-subtitle" class="text-[10px] text-slate-400 font-medium">Simulasi Keuangan Edukatif</span>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <!-- Notification Bell -->
          <button onclick="openModal('modal-notifications')" class="relative p-2.5 rounded-xl bg-lightGray hover:bg-softMint text-darkNavy transition">
            <i data-lucide="bell" class="w-5 h-5"></i>
            <span id="notif-badge" class="absolute top-2 right-2 w-2 h-2 rounded-full bg-riskRed ring-2 ring-white"></span>
          </button>
          <!-- Help Center -->
          <button onclick="openModal('modal-help')" class="p-2.5 rounded-xl bg-lightGray hover:bg-softMint text-darkNavy transition">
            <i data-lucide="help-circle" class="w-5 h-5"></i>
          </button>
        </div>
      </header>

      <!-- DYNAMIC CONTENT CONTAINER -->
      <main id="main-content" class="flex-1 px-5 pt-4 space-y-5">

        <!-- ======================================== -->
        <!-- VIEW 1: HOME (DASHBOARD UTAMA)           -->
        <!-- ======================================== -->
        <section id="view-home" class="page-section space-y-5">
          <!-- Greeting -->
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs text-slate-500 font-medium" id="home-role-label">Mahasiswa • Tingkat Pemula</p>
              <h1 class="font-heading font-bold text-xl text-darkNavy" id="home-greeting">Halo, Selamat Datang! 👋</h1>
            </div>
            <div class="px-3 py-1.5 rounded-full bg-softMint text-emeraldPrimary text-xs font-semibold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emeraldPrimary animate-pulse"></span>
              <span>Mode Edukasi</span>
            </div>
          </div>

          <!-- Financial Resilience Hero Card -->
          <div class="bg-darkNavy text-white rounded-3xl p-5 shadow-soft relative overflow-hidden">
            <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-emeraldPrimary/20 blur-xl"></div>
            <div class="absolute -left-6 -bottom-10 w-28 h-28 rounded-full bg-goldAccent/15 blur-lg"></div>

            <div class="relative z-10">
              <div class="flex justify-between items-start mb-3">
                <div>
                  <span class="text-xs text-slate-300 font-medium">Indikator Ketahanan Keuangan</span>
                  <div class="flex items-baseline gap-2 mt-1">
                    <span id="home-resilience-score" class="font-heading font-extrabold text-3xl text-white">76</span>
                    <span class="text-xs text-slate-300">/ 100 Poin</span>
                  </div>
                </div>
                <span id="home-resilience-badge" class="px-3 py-1 rounded-full bg-emeraldPrimary text-white text-xs font-semibold">
                  Cukup Tangguh
                </span>
              </div>

              <div class="w-full h-2.5 bg-white/15 rounded-full overflow-hidden mb-3">
                <div id="home-resilience-bar" class="h-full bg-goldAccent rounded-full transition-all duration-500" style="width: 76%"></div>
              </div>

              <p id="home-resilience-summary" class="text-xs text-slate-200 leading-relaxed mb-4">
                Sisa arus kasmu positif (+Rp 1.150.000/bln), namun dana darurat baru mencukupi 1,4 bulan pengeluaran.
              </p>

              <div class="grid grid-cols-2 gap-2.5 pt-3 border-t border-white/10 mb-4">
                <div>
                  <span class="text-[11px] text-slate-300 block">Pendapatan Bulanan</span>
                  <span id="home-income-val" class="font-heading font-semibold text-sm text-white">Rp 3.500.000</span>
                </div>
                <div>
                  <span class="text-[11px] text-slate-300 block">Pengeluaran + Cicilan</span>
                  <span id="home-expense-val" class="font-heading font-semibold text-sm text-goldAccent">Rp 2.350.000</span>
                </div>
              </div>

              <button onclick="navigateTo('simulasi')" class="w-full py-3 bg-emeraldPrimary hover:bg-emeraldDark text-white font-heading font-semibold text-sm rounded-2xl shadow-float transition active:scale-[0.98] flex items-center justify-center gap-2">
                <i data-lucide="play-circle" class="w-4 h-4"></i>
                <span>Mulai Simulasi</span>
              </button>
            </div>
          </div>

          <!-- Grafik Pendapatan vs Pengeluaran -->
          <div class="bg-white border border-slate-100 rounded-3xl p-4 shadow-card">
            <div class="flex items-center justify-between mb-3">
              <div>
                <h2 class="font-heading font-bold text-sm text-darkNavy">Arus Kas Bulanan</h2>
                <p class="text-[11px] text-slate-400">Perbandingan pemasukan & pengeluaran</p>
              </div>
              <button onclick="navigateTo('keuangan')" class="text-xs font-semibold text-emeraldPrimary hover:underline">
                Ubah Data
              </button>
            </div>
            <div class="h-44 w-full">
              <canvas id="homeCashflowChart"></canvas>
            </div>
          </div>

          <!-- 6 MENU FITUR UTAMA -->
          <div>
            <div class="flex items-center justify-between mb-3">
              <h2 class="font-heading font-bold text-base text-darkNavy">6 Fitur Utama KoperasiLab</h2>
              <span class="text-[11px] text-slate-400">Pilih langkahmu</span>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <!-- 1. Ukuran Kondisi Keuangan -->
              <button onclick="navigateTo('keuangan')" class="text-left p-4 rounded-2xl bg-softMint/70 hover:bg-softMint border border-emeraldPrimary/15 transition active:scale-[0.98]">
                <div class="w-10 h-10 rounded-xl bg-emeraldPrimary text-white flex items-center justify-center mb-3 shadow-xs">
                  <i data-lucide="wallet" class="w-5 h-5"></i>
                </div>
                <h3 class="font-heading font-bold text-xs text-darkNavy mb-1">1. Kondisi Keuangan</h3>
                <p class="text-[11px] text-slate-600 leading-snug">Petakan arus kas, simpanan & cicilan awal.</p>
              </button>

              <!-- 2. Jalankan Simulasi -->
              <button onclick="navigateTo('simulasi')" class="text-left p-4 rounded-2xl bg-lightGray hover:bg-slate-200/70 border border-slate-200/60 transition active:scale-[0.98]">
                <div class="w-10 h-10 rounded-xl bg-darkNavy text-white flex items-center justify-center mb-3 shadow-xs">
                  <i data-lucide="activity" class="w-5 h-5"></i>
                </div>
                <h3 class="font-heading font-bold text-xs text-darkNavy mb-1">2. Jalankan Simulasi</h3>
                <p class="text-[11px] text-slate-600 leading-snug">Uji skenario krisis & ketahanan kasmu.</p>
              </button>

              <!-- 3. Risiko Pembiayaan -->
              <button onclick="navigateTo('risiko')" class="text-left p-4 rounded-2xl bg-lightGray hover:bg-slate-200/70 border border-slate-200/60 transition active:scale-[0.98]">
                <div class="w-10 h-10 rounded-xl bg-riskRed text-white flex items-center justify-center mb-3 shadow-xs">
                  <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
                <h3 class="font-heading font-bold text-xs text-darkNavy mb-1">3. Risiko Pembiayaan</h3>
                <p class="text-[11px] text-slate-600 leading-snug">Cek batas aman cicilan & potensi gagal bayar.</p>
              </button>

              <!-- 4. Kaji Kelayakan Usaha -->
              <button onclick="navigateTo('usaha')" class="text-left p-4 rounded-2xl bg-lightGray hover:bg-slate-200/70 border border-slate-200/60 transition active:scale-[0.98]">
                <div class="w-10 h-10 rounded-xl bg-goldAccent text-darkNavy flex items-center justify-center mb-3 shadow-xs">
                  <i data-lucide="store" class="w-5 h-5"></i>
                </div>
                <h3 class="font-heading font-bold text-xs text-darkNavy mb-1">4. Kelayakan Usaha</h3>
                <p class="text-[11px] text-slate-600 leading-snug">Hitung BEP, modal awal & proyeksi laba.</p>
              </button>

              <!-- 5. Arahkan Pembelajaran -->
              <button onclick="navigateTo('edukasi')" class="text-left p-4 rounded-2xl bg-lightGray hover:bg-slate-200/70 border border-slate-200/60 transition active:scale-[0.98]">
                <div class="w-10 h-10 rounded-xl bg-emeraldPrimary/90 text-white flex items-center justify-center mb-3 shadow-xs">
                  <i data-lucide="graduation-cap" class="w-5 h-5"></i>
                </div>
                <h3 class="font-heading font-bold text-xs text-darkNavy mb-1">5. Belajar Adaptif</h3>
                <p class="text-[11px] text-slate-600 leading-snug">Materi & kuis sesuai kelemahan simulasi.</p>
              </button>

              <!-- 6. Sambungkan ke Koperasi -->
              <button onclick="navigateTo('koperasi')" class="text-left p-4 rounded-2xl bg-softMint/70 hover:bg-softMint border border-emeraldPrimary/15 transition active:scale-[0.98]">
                <div class="w-10 h-10 rounded-xl bg-darkNavy text-goldAccent flex items-center justify-center mb-3 shadow-xs">
                  <i data-lucide="handshake" class="w-5 h-5"></i>
                </div>
                <h3 class="font-heading font-bold text-xs text-darkNavy mb-1">6. Mitra Koperasi</h3>
                <p class="text-[11px] text-slate-600 leading-snug">Konsultasi & pendampingan koperasi muda.</p>
              </button>
            </div>
          </div>

          <!-- Artikel & Tips Edukasi Finansial -->
          <div class="pb-2">
            <div class="flex items-center justify-between mb-3">
              <h2 class="font-heading font-bold text-base text-darkNavy">Tips Finansial Pilihan</h2>
              <button onclick="navigateTo('edukasi')" class="text-xs font-semibold text-emeraldPrimary">Lihat Semua</button>
            </div>

            <div class="space-y-3">
              <div onclick="openArticleModal(0)" class="p-3.5 rounded-2xl bg-white border border-slate-100 shadow-card flex items-center gap-3.5 cursor-pointer hover:border-emeraldPrimary/40 transition">
                <div class="w-12 h-12 rounded-2xl bg-softMint text-emeraldPrimary flex items-center justify-center shrink-0">
                  <i data-lucide="piggy-bank" class="w-6 h-6"></i>
                </div>
                <div class="flex-1">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-emeraldPrimary">Dana Darurat</span>
                  <h4 class="font-heading font-semibold text-xs text-darkNavy mt-0.5">Aturan 3x Pengeluaran untuk Mahasiswa & Freelancer</h4>
                  <p class="text-[11px] text-slate-400 mt-0.5">Baca 2 menit • Tingkat Pemula</p>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
              </div>

              <div onclick="openArticleModal(1)" class="p-3.5 rounded-2xl bg-white border border-slate-100 shadow-card flex items-center gap-3.5 cursor-pointer hover:border-emeraldPrimary/40 transition">
                <div class="w-12 h-12 rounded-2xl bg-amber-50 text-goldAccent flex items-center justify-center shrink-0">
                  <i data-lucide="shield-alert" class="w-6 h-6"></i>
                </div>
                <div class="flex-1">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-amber-600">Risiko Cicilan</span>
                  <h4 class="font-heading font-semibold text-xs text-darkNavy mt-0.5">Kenapa Rasio Cicilan Maksimal 30% dari Pendapatan?</h4>
                  <p class="text-[11px] text-slate-400 mt-0.5">Baca 3 menit • Wajib Tahu</p>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 text-slate-400"></i>
              </div>
            </div>
          </div>
        </section>

        <!-- ======================================== -->
        <!-- VIEW 2: FITUR 1 - UKURAN KONDISI KEUANGAN-->
        <!-- ======================================== -->
        <section id="view-keuangan" class="hidden page-section space-y-5">
          <div class="bg-softMint rounded-3xl p-4 border border-emeraldPrimary/15">
            <h2 class="font-heading font-bold text-base text-darkNavy">Pemetaan Kondisi Keuangan</h2>
            <p class="text-xs text-slate-600 mt-1">Masukkan data secara mandiri. Data ini menjadi dasar seluruh simulasi ketahananmu.</p>
          </div>

          <!-- Form Input Mandiri -->
          <div class="bg-white border border-slate-100 rounded-3xl p-4 shadow-card space-y-3.5">
            <div>
              <label class="block text-xs font-semibold text-darkNavy mb-1">Pendapatan Bulanan (Rp)</label>
              <input type="number" id="fin-income" value="3500000" oninput="recalculateFinance()" class="w-full px-3.5 py-2.5 rounded-xl bg-lightGray text-sm font-semibold text-darkNavy outline-none focus:ring-2 focus:ring-emeraldPrimary" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-darkNavy mb-1">Pengeluaran Rutin Bulanan (Rp)</label>
