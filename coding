    function recalculateFinance() {
      const income = Number(document.getElementById('fin-income').value) || 0;
      const expense = Number(document.getElementById('fin-expense').value) || 0;
      const savings = Number(document.getElementById('fin-savings').value) || 0;
      const debt = Number(document.getElementById('fin-debt').value) || 0;
      const installment = Number(document.getElementById('fin-installment').value) || 0;
      const dueDate = document.getElementById('fin-duedate').value;

      appState.finance = { income, expense, savings, debt, installment, dueDate };

      const totalOut = expense + installment;
      const netCash = income - totalOut;
      const ratio = income > 0 ? ((totalOut / income) * 100) : 100;
      const emergencyMonths = totalOut > 0 ? (savings / totalOut) : 0;

      // Hitung Skor Ketahanan (0-100)
      let score = 50;
      if (netCash > 0) score += Math.min(25, Math.round((netCash / (income || 1)) * 60));
      else score -= 20;
      score += Math.min(25, Math.round(emergencyMonths * 8));
      score = Math.max(15, Math.min(98, score));

      // Update UI Fitur 1
      document.getElementById('res-total-expense').textContent = formatRp(totalOut);
      document.getElementById('res-net-cashflow').textContent = (netCash >= 0 ? '+' : '') + formatRp(netCash);
      document.getElementById('res-net-cashflow').className = `font-heading font-bold text-base ${netCash >= 0 ? 'text-emerald-300' : 'text-red-300'}`;
      document.getElementById('res-expense-ratio').textContent = `${ratio.toFixed(1)}%`;
      document.getElementById('res-expense-bar').style.width = `${Math.min(100, ratio)}%`;

      const badge = document.getElementById('fin-status-badge');
      if (netCash > 0 && ratio <= 75) {
        badge.textContent = 'Surplus Sehat';
        badge.className = 'px-2.5 py-1 rounded-full bg-emeraldPrimary text-[11px] font-semibold';
      } else if (netCash >= 0) {
        badge.textContent = 'Arus Kas Ketat';
        badge.className = 'px-2.5 py-1 rounded-full bg-goldAccent text-darkNavy text-[11px] font-semibold';
      } else {
        badge.textContent = 'Defisit Kas';
        badge.className = 'px-2.5 py-1 rounded-full bg-riskRed text-white text-[11px] font-semibold';
      }

      document.getElementById('res-fin-summary').textContent =
        `Sisa arus kasmu ${formatRp(netCash)}/bulan. Simpanan Rp ${savings.toLocaleString('id-ID')} mencukupi ${emergencyMonths.toFixed(1)} bulan kebutuhan rutin.`;

      // Sinkronkan ke Home Dashboard & Simulasi
      document.getElementById('home-resilience-score').textContent = score;
      document.getElementById('home-resilience-bar').style.width = `${score}%`;
      document.getElementById('home-income-val').textContent = formatRp(income);
      document.getElementById('home-expense-val').textContent = formatRp(totalOut);
      document.getElementById('home-resilience-badge').textContent = score >= 75 ? 'Cukup Tangguh' : (score >= 50 ? 'Perlu Penguatan' : 'Rentan');
      document.getElementById('home-resilience-summary').textContent =
        `Sisa arus kasmu ${netCash >= 0 ? 'positif' : 'defisit'} (${formatRp(netCash)}/bln), dengan dana darurat ${emergencyMonths.toFixed(1)} bulan pengeluaran.`;

      document.getElementById('risk-income').value = income;
      updateCharts();
      runSimulation(false);
      calculateRisk();
      updateCoopSharePreview();
    }

